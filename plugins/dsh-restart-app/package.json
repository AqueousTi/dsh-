{
  "name": "dsh-restart-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "在侧栏放一个「重启 DSH」按钮",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
